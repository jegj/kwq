generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email        String        @unique
  passwordHash String        @map("password_hash")
  role         Role          @default(USER)
  webhookToken String?       @unique @map("webhook_token")
  createdAt    DateTime      @db.Timestamptz(3) @default(now()) @map("created_at")
  updatedAt    DateTime      @db.Timestamptz(3) @updatedAt @map("updated_at")
  categories   Category[]
  emails       EmailNotification[]
  transactions Transaction[]
  activities   UserActivity[]

  @@map("user")
}

enum Role {
  USER
  ADMIN
}

model Category {
  id           String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String?       @db.Uuid @map("user_id")
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  icon         String?
  color        String?
  createdAt    DateTime      @db.Timestamptz(3) @default(now()) @map("created_at")
  updatedAt    DateTime      @db.Timestamptz(3) @updatedAt @map("updated_at")
  transactions Transaction[]

  @@unique([userId, name])
  @@map("category")
}

model EmailNotification {
  id            String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String       @db.Uuid @map("user_id")
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId     String       @map("message_id")
  fromAddress   String       @map("from_address")
  subject       String
  body          String
  bodyHtml      String       @map("body_html")
  receivedAt    DateTime     @db.Timestamptz(3) @map("received_at")
  parseStatus   ParseStatus  @default(UNPARSED) @map("parse_status")
  parserName    String?      @map("parser_name")
  transactionId String?      @unique @db.Uuid @map("transaction_id")
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @db.Timestamptz(3) @default(now()) @map("created_at")
  updatedAt     DateTime     @db.Timestamptz(3) @updatedAt @map("updated_at")

  @@unique([userId, messageId])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("email_notification")
}

enum ParseStatus {
  UNPARSED
  PARSED
  FAILED
}

enum OperationType {
  CREDIT
  DEBIT
  UNKNOWN
}

model Transaction {
  id                    String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId                String    @db.Uuid @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId            String?   @db.Uuid @map("category_id")
  category              Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  amount                Decimal   @db.Decimal(12, 2)
  currency              String    @db.Char(3)
  merchant              String
  description           String?
  cardLastFour          String?   @map("card_last_four")
  operationNumber       String?   @map("operation_number")
  operationDescription  String?   @map("operation_description")
  operationType         OperationType? @map("operation_type")
  transactionDate       DateTime  @db.Timestamptz(3) @map("transaction_date")
  isManuallyCategorized Boolean   @default(false) @map("is_manually_categorized")
  email                 EmailNotification?
  createdAt             DateTime  @db.Timestamptz(3) @default(now()) @map("created_at")
  updatedAt             DateTime  @db.Timestamptz(3) @updatedAt @map("updated_at")

  @@index([userId, transactionDate])
  @@map("transaction")
}

model UserActivity {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  createdAt DateTime @db.Timestamptz(3) @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("user_activity")
}
