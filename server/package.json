{
  "name": "nest-typescript-starter",
  "version": "0.1.0",
  "description": "Nest TypeScript starter repository",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist tsconfig.build.tsbuildinfo && nest build && npm run build:assets",
    "build:assets": "node scripts/build-assets.mjs",
    "build:assets:watch": "node scripts/build-assets.mjs --watch",
    "deploy": "nest deploy",
    "format": "biome format --write .",
    "start": "nest start",
    "start:dev": "npm run build:assets:watch & nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "biome lint src/ test/ assets/js scripts/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "check": "biome check --write"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/static": "10.1.6",
    "@fastify/view": "12.0.1",
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/observe": "0.3.10",
    "@nestjs/platform-fastify": "12.1.3",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.4.2",
    "ejs": "6.0.1",
    "jsonwebtoken": "9.0.3",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@nestjs/cli": "12.0.8",
    "@nestjs/mau": "0.2.8",
    "@nestjs/schematics": "12.0.7",
    "@nestjs/testing": "12.1.3",
    "@picocss/pico": "2.1.1",
    "@types/ejs": "3.1.5",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.13.3",
    "@types/supertest": "7.2.1",
    "@types/web-push": "3.6.4",
    "@vitest/coverage-v8": "5.0.4",
    "alpinejs": "3.17.4",
    "chart.js": "4.5.1",
    "esbuild": "0.28.2",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.0",
    "source-map-support": "0.5.21",
    "supertest": "7.3.1",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.4"
  }
}
