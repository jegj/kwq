NODE_ENV=production
APP_ENV=development
# Origin users reach the app at (e.g. https://kwq.example.com). Mutations from any other
# origin are rejected. Defaults to http://localhost:$PORT.
PUBLIC_URL=http://localhost:3000
# Zone of the bank emails and the people reading them (zone-less text is read in it).
APP_TIMEZONE=America/Lima

POSTGRES_USER=kwq
POSTGRES_PASSWORD=kwq
POSTGRES_DB=kwq_dev
DATABASE_URL="postgresql://kwq:kwq@localhost:5432/kwq_dev?schema=public"

# Seeded by `npm run db:seed` — omit ADMIN_PASSWORD to have one generated and printed once.
ADMIN_EMAIL=admin@kwq.local
ADMIN_PASSWORD=

# Signs the login session JWT — use a long random value in staging/production.
JWT_SECRET=

# Observe telemetry (observe.nestjs.com) — only registered when APP_ENV=production.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
