<div
  x-data="{
    summaries: <%= JSON.stringify(summaries) %>,
    active: 0,
    get summary() { return this.summaries[this.active]; },
    money(value, currency = 'PEN') {
      const symbols = { PEN: 'S/ ', USD: '$' };
      return (symbols[currency] ?? currency + ' ') + value.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    },
    init() {
      const muted = '#8b95a7';
      const trend = new Chart(this.$refs.trend, {
        type: 'bar',
        data: { labels: [], datasets: [{ data: [], backgroundColor: '#e08a83', borderRadius: 3 }] },
        options: {
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            x: { grid: { display: false }, ticks: { color: muted } },
            y: { grid: { color: 'rgba(139,149,167,0.15)' }, ticks: { color: muted }, border: { display: false } },
          },
        },
      });
      const renderTrend = () => {
        const daily = this.summary ? this.summary.daily : [];
        trend.data.labels = daily.map((_, index) => index + 1);
        trend.data.datasets[0].data = daily;
        trend.update();
      };
      renderTrend();
      this.$watch('active', renderTrend);
      const split = new Chart(this.$refs.split, {
        type: 'doughnut',
        data: { labels: [], datasets: [{ data: [], backgroundColor: [], borderWidth: 0 }] },
        options: { maintainAspectRatio: false, cutout: '70%', plugins: { legend: { display: false } } },
      });
      const renderSplit = () => {
        const categories = this.summary ? this.summary.categories : [];
        split.data.labels = categories.map((category) => category.name);
        split.data.datasets[0].data = categories.map((category) => category.amount);
        split.data.datasets[0].backgroundColor = categories.map((category) => category.color);
        split.update();
      };
      renderSplit();
      this.$watch('active', renderSplit);
    },
  }"
>
  <div class="dash-head">
    <h1>Dashboard</h1>
    <nav class="dash-month" aria-label="Month">
      <a href="?month=<%= monthNav.prev %>" aria-label="Previous month">‹</a>
      <strong><%= monthNav.label %></strong>
      <% if (monthNav.next) { %>
        <a href="?month=<%= monthNav.next %>" aria-label="Next month">›</a>
      <% } else { %>
        <span aria-hidden="true" class="dash-month-off">›</span>
      <% } %>
    </nav>
  </div>

  <p x-show="!summaries.length" style="color: var(--pico-muted-color);">No transactions in <%= monthNav.label %>.</p>

  <div x-show="summaries.length > 1" role="group" style="margin-top: 1rem;">
    <template x-for="(item, index) in summaries" :key="item.currency">
      <button type="button" :class="index === active ? '' : 'outline'" x-on:click="active = index" x-text="item.currency"></button>
    </template>
  </div>

  <p class="dash-alert" x-show="summary && summary.uncategorized > 0" role="status">
    <span x-text="summary && summary.uncategorized + (summary.uncategorized === 1 ? ' transaction has' : ' transactions have') + ' no category.'"></span>
    <a href="/app/transactions">Review</a>
  </p>

  <section class="dash-stats" aria-label="Summary" x-show="summary">
    <article class="dash-stat">
      <small>Spent</small>
      <strong x-text="summary && money(summary.total, summary.currency)"></strong>
      <span class="dash-delta" x-show="summary && summary.delta !== null" :class="summary && summary.delta > 0 ? 'dash-up' : 'dash-down'" x-text="summary && summary.delta !== null ? (summary.delta > 0 ? '▲ ' : '▼ ') + Math.abs(summary.delta) + '% vs last month' : ''"></span>
    </article>
    <article class="dash-stat">
      <small>Transactions</small>
      <strong x-text="summary && summary.count"></strong>
    </article>
    <article class="dash-stat">
      <small>Average</small>
      <strong x-text="summary && money(summary.average, summary.currency)"></strong>
    </article>
    <article class="dash-stat">
      <small>Top category</small>
      <strong x-text="summary && (summary.topCategory ?? '—')"></strong>
    </article>
  </section>

  <section class="dash-grid" x-show="summary">
    <article>
      <h2>Daily spending</h2>
      <div class="dash-chart"><canvas x-ref="trend" role="img" aria-label="Daily spending bar chart"></canvas></div>
    </article>
    <article>
      <h2>By category</h2>
      <div class="dash-chart" style="height: 9rem;"><canvas x-ref="split" role="img" aria-label="Spending by category chart"></canvas></div>
      <ul class="dash-list" style="margin-top: 1rem;">
        <template x-for="category in (summary ? summary.categories : [])" :key="category.name">
          <li>
            <span class="dash-dot" :style="'background:' + category.color"></span>
            <span class="dash-merchant" x-text="category.name"></span>
            <span class="dash-amount" x-text="money(category.amount, summary.currency)"></span>
          </li>
        </template>
      </ul>
    </article>
  </section>

  <section class="dash-lists" x-show="summary">
    <article>
      <h2>Recent transactions</h2>
      <ul class="dash-list">
        <template x-for="item in (summary ? summary.recent : [])" :key="item.id">
          <li>
            <span class="dash-dot" :style="'background:' + item.color"></span>
            <a class="dash-merchant" :href="'/app/transactions/' + item.id"><span x-text="item.merchant"></span> <small style="color: var(--pico-muted-color);" x-text="'· ' + (item.categoryName ?? 'Uncategorized') + ' · ' + item.date"></small></a>
            <span class="dash-amount" x-text="money(item.amount, summary.currency)"></span>
          </li>
        </template>
      </ul>
      <a href="/app/transactions" style="font-size: 0.85rem;">View all</a>
    </article>
    <article>
      <h2>Biggest transactions</h2>
      <ul class="dash-list">
        <template x-for="item in (summary ? summary.biggest : [])" :key="item.id">
          <li>
            <span class="dash-dot" :style="'background:' + item.color"></span>
            <a class="dash-merchant" :href="'/app/transactions/' + item.id"><span x-text="item.merchant"></span> <small style="color: var(--pico-muted-color);" x-text="'· ' + (item.categoryName ?? 'Uncategorized') + ' · ' + item.date"></small></a>
            <span class="dash-amount" x-text="money(item.amount, summary.currency)"></span>
          </li>
        </template>
      </ul>
    </article>
    <article>
      <h2>Top merchants</h2>
      <ul class="dash-list">
        <template x-for="entry in (summary ? summary.topMerchants : [])" :key="entry.merchant">
          <li>
            <span class="dash-merchant"><span x-text="entry.merchant"></span> <small style="color: var(--pico-muted-color);" x-text="'· ' + entry.count + (entry.count === 1 ? ' purchase' : ' purchases')"></small></span>
            <span class="dash-amount" x-text="money(entry.amount, summary.currency)"></span>
          </li>
        </template>
      </ul>
    </article>
  </section>
</div>

<script src="/assets/charts.js?v=<%= assetVersion %>"></script>
