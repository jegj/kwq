<style>
  .dash-head { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem; }
  .dash-head h1 { margin-bottom: 0; }
  .dash-month { display: flex; align-items: center; gap: 0.75rem; }
  .dash-month a, .dash-month-off { font-size: 1.4rem; text-decoration: none; line-height: 1; padding: 0 0.4rem; }
  .dash-month-off { color: var(--pico-muted-color); opacity: 0.4; }
  .dash-alert { margin: 1rem 0 0; padding: 0.6rem 1rem; border-radius: var(--pico-border-radius); border: 1px solid #e0af68; color: #e0af68; }
  .dash-alert a { margin-left: 0.5rem; }
  .dash-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 1rem; margin: 1.5rem 0; }
  .dash-stat { margin: 0; padding: 1rem 1.25rem; }
  .dash-stat small { display: block; color: var(--pico-muted-color); text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.7rem; }
  .dash-stat strong { display: block; font-size: 1.6rem; line-height: 1.3; font-variant-numeric: tabular-nums; }
  .dash-delta { font-size: 0.8rem; }
  .dash-up { color: #e08a83; }
  .dash-down { color: #6fcf97; }
  .dash-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 1rem; }
  .dash-grid article { margin: 0; }
  .dash-grid h2 { font-size: 1rem; margin-bottom: 1rem; color: var(--pico-muted-color); font-weight: 500; }
  .dash-chart { position: relative; height: 15rem; }
  .dash-list { list-style: none; margin: 0; padding: 0; }
  .dash-list li { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; padding: 0.6rem 0; border-bottom: 1px solid var(--pico-muted-border-color); }
  .dash-list li:last-child { border-bottom: 0; padding-bottom: 0; }
  .dash-dot { width: 0.6rem; height: 0.6rem; border-radius: 50%; flex: none; }
  .dash-merchant { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dash-amount { font-variant-numeric: tabular-nums; }
  .dash-lists { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 1rem; margin-top: 1rem; }
  .dash-lists article { margin: 0; }
  .dash-lists h2 { font-size: 1rem; margin-bottom: 1rem; color: var(--pico-muted-color); font-weight: 500; }
  .dash-list a.dash-merchant { text-decoration: none; color: inherit; }
  .dash-grid > *, .dash-stats > *, .dash-lists > * { min-width: 0; }
  @media (max-width: 768px) { .dash-grid { grid-template-columns: 1fr; } }
  @media (max-width: 480px) {
    .dash-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; margin: 1rem 0; }
    .dash-stat { padding: 0.75rem 1rem; }
    .dash-stat strong { font-size: 1.2rem; overflow-wrap: anywhere; }
    .dash-grid article, .dash-lists article { padding: 1rem; }
    .dash-chart { height: 12rem; }
  }
</style>

<div
  x-data="{
    summaries: <%= JSON.stringify(summaries) %>,
    active: 0,
    get summary() { return this.summaries[this.active]; },
    money(value, currency = 'PEN') {
      const symbols = { PEN: 'S/ ', USD: '$' };
      return (symbols[currency] ?? currency + ' ') + value.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    },
    init() {
      const muted = '#8b95a7';
      const trend = new Chart(this.$refs.trend, {
        type: 'line',
        data: {
          labels: [],
          datasets: [
            { label: 'This month', data: [], borderColor: '#e08a83', backgroundColor: 'rgba(224,138,131,0.12)', fill: true, tension: 0.35, pointRadius: 0, borderWidth: 2 },
            { label: 'Last month', data: [], borderColor: muted, borderDash: [5, 4], tension: 0.35, pointRadius: 0, borderWidth: 1.5 },
          ],
        },
        options: {
          maintainAspectRatio: false,
          plugins: { legend: { labels: { color: muted, boxWidth: 12 } } },
          scales: {
            x: { grid: { display: false }, ticks: { color: muted } },
            y: { grid: { color: 'rgba(139,149,167,0.15)' }, ticks: { color: muted }, border: { display: false } },
          },
        },
      });
      const renderTrend = () => {
        const pace = this.summary ? this.summary.pace : { current: [], previous: [] };
        const days = Math.max(pace.current.length, pace.previous.length);
        trend.data.labels = Array.from({ length: days }, (_, index) => index + 1);
        trend.data.datasets[0].data = pace.current;
        trend.data.datasets[1].data = pace.previous;
        trend.data.datasets[1].hidden = !pace.previous.length;
        trend.update();
      };
      renderTrend();
      this.$watch('active', renderTrend);
      const split = new Chart(this.$refs.split, {
        type: 'doughnut',
        data: { labels: [], datasets: [{ data: [], backgroundColor: [], borderWidth: 0 }] },
        options: { maintainAspectRatio: false, cutout: '70%', plugins: { legend: { display: false } } },
      });
      const renderSplit = () => {
        const categories = this.summary ? this.summary.categories : [];
        split.data.labels = categories.map((category) => category.name);
        split.data.datasets[0].data = categories.map((category) => category.amount);
        split.data.datasets[0].backgroundColor = categories.map((category) => category.color);
        split.update();
      };
      renderSplit();
      this.$watch('active', renderSplit);
    },
  }"
>
  <div class="dash-head">
    <h1>Dashboard</h1>
    <nav class="dash-month" aria-label="Month">
      <a href="?month=<%= monthNav.prev %>" aria-label="Previous month">‹</a>
      <strong><%= monthNav.label %></strong>
      <% if (monthNav.next) { %>
        <a href="?month=<%= monthNav.next %>" aria-label="Next month">›</a>
      <% } else { %>
        <span aria-hidden="true" class="dash-month-off">›</span>
      <% } %>
    </nav>
  </div>

  <p x-show="!summaries.length" style="color: var(--pico-muted-color);">No transactions in <%= monthNav.label %>.</p>

  <div x-show="summaries.length > 1" role="group" style="margin-top: 1rem;">
    <template x-for="(item, index) in summaries" :key="item.currency">
      <button type="button" :class="index === active ? '' : 'outline'" x-on:click="active = index" x-text="item.currency"></button>
    </template>
  </div>

  <p class="dash-alert" x-show="summary && summary.uncategorized > 0" role="status">
    <span x-text="summary && summary.uncategorized + (summary.uncategorized === 1 ? ' transaction has' : ' transactions have') + ' no category.'"></span>
    <a href="/app/transactions">Review</a>
  </p>

  <section class="dash-stats" aria-label="Summary" x-show="summary">
    <article class="dash-stat">
      <small>Spent</small>
      <strong x-text="summary && money(summary.total, summary.currency)"></strong>
      <span class="dash-delta" x-show="summary && summary.delta !== null" :class="summary && summary.delta > 0 ? 'dash-up' : 'dash-down'" x-text="summary && summary.delta !== null ? (summary.delta > 0 ? '▲ ' : '▼ ') + Math.abs(summary.delta) + '% vs last month' : ''"></span>
    </article>
    <article class="dash-stat">
      <small>Transactions</small>
      <strong x-text="summary && summary.count"></strong>
    </article>
    <article class="dash-stat">
      <small>Average</small>
      <strong x-text="summary && money(summary.average, summary.currency)"></strong>
    </article>
    <article class="dash-stat">
      <small>Top category</small>
      <strong x-text="summary && (summary.topCategory ?? '—')"></strong>
    </article>
  </section>

  <section class="dash-grid" x-show="summary">
    <article>
      <h2>Spending pace (cumulative)</h2>
      <div class="dash-chart"><canvas x-ref="trend" role="img" aria-label="Cumulative spending by day, compared with last month"></canvas></div>
    </article>
    <article>
      <h2>By category</h2>
      <div class="dash-chart" style="height: 9rem;"><canvas x-ref="split" role="img" aria-label="Spending by category chart"></canvas></div>
      <ul class="dash-list" style="margin-top: 1rem;">
        <template x-for="category in (summary ? summary.categories : [])" :key="category.name">
          <li>
            <span class="dash-dot" :style="'background:' + category.color"></span>
            <span class="dash-merchant" x-text="category.name"></span>
            <span class="dash-amount" x-text="money(category.amount, summary.currency)"></span>
          </li>
        </template>
      </ul>
    </article>
  </section>

  <section class="dash-lists" x-show="summary">
    <article>
      <h2>Recent transactions</h2>
      <ul class="dash-list">
        <template x-for="item in (summary ? summary.recent : [])" :key="item.id">
          <li>
            <span class="dash-dot" :style="'background:' + item.color"></span>
            <a class="dash-merchant" :href="'/app/transactions/' + item.id"><span x-text="item.merchant"></span> <small style="color: var(--pico-muted-color);" x-text="'· ' + (item.categoryName ?? 'Uncategorized') + ' · ' + item.date"></small></a>
            <span class="dash-amount" x-text="money(item.amount, summary.currency)"></span>
          </li>
        </template>
      </ul>
      <a href="/app/transactions" style="font-size: 0.85rem;">View all</a>
    </article>
    <article>
      <h2>Biggest transactions</h2>
      <ul class="dash-list">
        <template x-for="item in (summary ? summary.biggest : [])" :key="item.id">
          <li>
            <span class="dash-dot" :style="'background:' + item.color"></span>
            <a class="dash-merchant" :href="'/app/transactions/' + item.id"><span x-text="item.merchant"></span> <small style="color: var(--pico-muted-color);" x-text="'· ' + (item.categoryName ?? 'Uncategorized') + ' · ' + item.date"></small></a>
            <span class="dash-amount" x-text="money(item.amount, summary.currency)"></span>
          </li>
        </template>
      </ul>
    </article>
    <article>
      <h2>Top merchants</h2>
      <ul class="dash-list">
        <template x-for="entry in (summary ? summary.topMerchants : [])" :key="entry.merchant">
          <li>
            <span class="dash-merchant"><span x-text="entry.merchant"></span> <small style="color: var(--pico-muted-color);" x-text="'· ' + entry.count + (entry.count === 1 ? ' purchase' : ' purchases')"></small></span>
            <span class="dash-amount" x-text="money(entry.amount, summary.currency)"></span>
          </li>
        </template>
      </ul>
    </article>
  </section>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
