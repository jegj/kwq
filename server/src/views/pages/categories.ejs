<div
  x-data="categoryManager"
>
  <div class="categories-header">
    <h1>Categories</h1>
    <button type="button" x-on:click="openAdd()">Add category</button>
  </div>

  <% if (categories.length === 0) { %>
  <p class="categories-empty">No categories yet. Add one to get started.</p>
  <% } else { %>
  <table>
    <thead>
      <tr>
        <th>Category</th>
        <th>Color</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% categories.forEach((category) => { %>
      <tr>
        <td data-label="Category">
          <span
            class="categories-chip"
            style="--category-color: <%= category.color ?? '#64748b' %>"
          >
            <span class="categories-icon" aria-hidden="true"><%= category.icon || '•' %></span>
            <%= category.name %>
          </span>
        </td>
        <td data-label="Color">
          <code class="categories-hex"><%= category.color ?? '—' %></code>
        </td>
        <% if (category.isOwnCategory) { %>
        <td class="categories-row-actions">
          <div class="categories-actions">
            <button
              type="button"
              class="outline secondary"
              data-category="<%= JSON.stringify({ id: category.id, name: category.name, icon: category.icon, color: category.color }) %>"
              x-on:click="openEdit(JSON.parse($el.dataset.category))"
            >Edit</button>
            <button
              type="button"
              class="outline secondary"
              data-category="<%= JSON.stringify({ id: category.id, name: category.name }) %>"
              x-on:click="openDelete(JSON.parse($el.dataset.category))"
            >Delete</button>
          </div>
        </td>
        <% } else { %>
        <td class="categories-row-actions">
          <div class="categories-actions">
            <span class="categories-badge" title="Shared default category. You can't edit or delete it.">Shared</span>
          </div>
        </td>
        <% } %>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>

  <dialog x-bind:open="dialog === 'add' || dialog === 'edit'">
    <article>
      <header>
        <button aria-label="Close" rel="prev" x-on:click="close()"></button>
        <strong x-text="dialog === 'edit' ? 'Edit category' : 'Add category'"></strong>
      </header>
      <form x-on:submit.prevent="save()">
        <label>
          Name
          <input
            type="text"
            name="name"
            required
            maxlength="50"
            x-model="form.name"
          />
        </label>
        <label>
          Icon
          <input
            type="text"
            name="icon"
            maxlength="16"
            placeholder="🍔"
            x-model="form.icon"
          />
        </label>
        <label>
          Color
          <input type="color" name="color" x-model="form.color" />
        </label>
        <p class="categories-form-error" role="alert" x-show="error" x-text="error" x-cloak></p>
        <footer>
          <button type="button" class="outline secondary" x-on:click="close()">Cancel</button>
          <button
            type="submit"
            x-bind:aria-busy="submitting"
            x-bind:disabled="submitting"
            x-text="dialog === 'edit' ? 'Save changes' : 'Add category'"
          ></button>
        </footer>
      </form>
    </article>
  </dialog>

  <dialog x-bind:open="dialog === 'delete'">
    <article>
      <header>
        <button aria-label="Close" rel="prev" x-on:click="close()"></button>
        <strong>Delete category</strong>
      </header>
      <p>Remove <strong x-text="selected ? selected.name : ''"></strong>? This can't be undone.</p>
      <p class="categories-form-error" role="alert" x-show="error" x-text="error" x-cloak></p>
      <footer>
        <button type="button" class="outline secondary" x-on:click="close()">Cancel</button>
        <button
          type="button"
          class="contrast"
          x-on:click="remove()"
          x-bind:aria-busy="submitting"
          x-bind:disabled="submitting"
        >Delete</button>
      </footer>
    </article>
  </dialog>
</div>
