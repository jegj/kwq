<div
  x-data="{
    hasToken: <%= hasWebhookToken %>,
    token: null,
    confirmOpen: false,
    generating: false,
    error: null,
    async generate() {
      this.generating = true;
      this.error = null;
      try {
        const response = await fetch('/app/settings/webhook-token', { method: 'POST' });
        if (response.status === 409) {
          this.hasToken = true;
          this.confirmOpen = false;
          return;
        }
        if (!response.ok) throw new Error('request failed');
        const data = await response.json();
        this.token = data.token;
        this.hasToken = true;
        this.confirmOpen = false;
      } catch (e) {
        this.error = 'Something went wrong generating the token. Try again.';
      } finally {
        this.generating = false;
      }
    },
  }"
>
  <h1>Settings</h1>

  <article>
    <header>
      <strong>Webhook token</strong>
    </header>

    <template x-if="!hasToken">
      <p>
        Your email watcher needs this token to send bank notifications here.
        Generate one to finish setup.
      </p>
    </template>

    <template x-if="hasToken && !token">
      <p>
        A webhook token is already set for this account. Ask your admin if
        you need it reset.
      </p>
    </template>

    <template x-if="token">
      <div class="webhook-token-reveal">
        <p>Copy this now. It won't be shown again.</p>
        <div role="group">
          <code x-text="token"></code>
          <button
            type="button"
            class="outline secondary"
            x-on:click="navigator.clipboard.writeText(token)"
          >Copy</button>
        </div>
      </div>
    </template>

    <p class="webhook-token-error" x-show="error" x-text="error" x-cloak></p>

    <button
      type="button"
      x-on:click="confirmOpen = true"
      x-bind:disabled="hasToken"
    >Generate webhook token</button>
  </article>

  <dialog x-bind:open="confirmOpen">
    <article>
      <header>
        <button aria-label="Close" rel="prev" x-on:click="confirmOpen = false"></button>
        <strong>Generate a webhook token?</strong>
      </header>
      <p>
        This creates the token your email watcher needs to send bank
        notifications here. You can't change it yourself afterward.
      </p>
      <footer>
        <button type="button" class="outline secondary" x-on:click="confirmOpen = false">Cancel</button>
        <button type="button" x-on:click="generate()" x-bind:aria-busy="generating" x-bind:disabled="generating">Generate</button>
      </footer>
    </article>
  </dialog>

  <article
    x-data="{
      currentPassword: '',
      newPassword: '',
      confirmPassword: '',
      saving: false,
      error: null,
      success: false,
      async changePassword() {
        this.error = null;
        this.success = false;
        if (this.newPassword !== this.confirmPassword) {
          this.error = 'New password and confirmation don\'t match.';
          return;
        }
        this.saving = true;
        try {
          const response = await fetch('/app/settings/password', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              currentPassword: this.currentPassword,
              newPassword: this.newPassword,
            }),
          });
          if (response.status === 401) {
            this.error = 'Current password is incorrect.';
            return;
          }
          if (!response.ok) throw new Error('request failed');
          this.success = true;
          this.currentPassword = '';
          this.newPassword = '';
          this.confirmPassword = '';
        } catch (e) {
          this.error = 'Something went wrong changing your password. Try again.';
        } finally {
          this.saving = false;
        }
      },
    }"
  >
    <header>
      <strong>Change password</strong>
    </header>

    <form x-on:submit.prevent="changePassword()">
      <label>
        Current password
        <input type="password" x-model="currentPassword" autocomplete="current-password" required />
      </label>
      <label>
        New password
        <input type="password" x-model="newPassword" autocomplete="new-password" minlength="8" required />
      </label>
      <label>
        Confirm new password
        <input type="password" x-model="confirmPassword" autocomplete="new-password" minlength="8" required />
      </label>

      <p class="webhook-token-error" x-show="error" x-text="error" x-cloak></p>
      <p x-show="success" x-cloak>Password changed.</p>

      <button type="submit" x-bind:aria-busy="saving" x-bind:disabled="saving">Change password</button>
    </form>
  </article>
</div>
