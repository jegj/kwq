<section class="not-found">
  <p class="not-found-code" aria-hidden="true">404</p>
  <h1>We couldn't find that page</h1>
  <p class="not-found-detail">
    <%= detail ?? 'The link may be mistyped, or what it pointed to was deleted.' %>
  </p>
  <div class="not-found-actions">
    <a href="/" role="button">Go to dashboard</a>
    <a href="javascript:history.back()" role="button" class="outline secondary">Go back</a>
  </div>
</section>
