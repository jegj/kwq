<div class="categories-header">
  <h1><%= notification.subject %></h1>
  <a href="/app/emails" role="button" class="outline secondary">Back to list</a>
</div>

<dl class="emails-meta">
  <dt>From</dt><dd><%= notification.fromAddress %></dd>
  <dt>Received</dt><dd><%= fmt.formatDateTime(notification.receivedAt) %></dd>
  <dt>Status</dt><dd><%= notification.parseStatus %></dd>
  <dt>Parser</dt><dd><%= notification.parserName ?? '—' %></dd>
  <dt>Message ID</dt><dd><code class="categories-hex"><%= notification.messageId %></code></dd>
  <% if (notification.transactionId) { %>
  <dt>Transaction</dt><dd><a href="/app/transactions/<%= notification.transactionId %>">View transaction</a></dd>
  <% } %>
</dl>

<%
  // ponytail: truncated HTML can be all <head>/CSS with no text; fall back to plain body then.
  const hasVisibleHtml = notification.bodyHtml
    .replace(/<(head|style|script)[\s\S]*?(<\/\1>|$)/gi, '')
    .replace(/<[^>]*>?/g, '')
    .trim() !== '';
%>
<% if (hasVisibleHtml) { %>
<%# ponytail: sandbox="" blocks scripts/forms/same-origin; the CSP meta is a second layer. Remote images stay allowed (bank logos), so tracking pixels load too. %>
<%
  const cspMeta = `<meta http-equiv="Content-Security-Policy" content="script-src 'none'; object-src 'none'; form-action 'none'">`;
%>
<iframe
  class="emails-preview"
  title="Email preview"
  sandbox=""
  referrerpolicy="no-referrer"
  srcdoc="<%= cspMeta + notification.bodyHtml %>"
></iframe>
<% } else { %>
<pre><%= notification.body %></pre>
<% } %>
