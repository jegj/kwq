<div x-data="transactionForm(false)">
  <div class="categories-header">
    <h1>Transactions</h1>
    <button type="button" x-on:click="openAdd()">Add transaction</button>
  </div>
  <form method="get" action="/app/transactions" class="emails-filter">
    <label>
      Month
      <input type="month" name="month" value="<%= month ?? '' %>" onchange="this.form.requestSubmit()" />
    </label>
    <noscript><button type="submit">Filter</button></noscript>
    <% if (month) { %>
    <a href="/app/transactions" role="button" class="outline secondary">Clear</a>
    <% } %>
  </form>

  <% if (transactions.length === 0) { %>
  <p class="categories-empty">No transactions<%= month ? ' for this month' : ' yet' %>. Add one, or wait for the next bank email.</p>
  <% } else { %>
  <div class="overflow-auto">
  <table class="list-table">
    <thead>
      <tr>
        <th>Date</th>
        <th>Merchant</th>
        <th>Category</th>
        <th class="amount">Amount</th>
        <th>Source</th>
      </tr>
    </thead>
    <tbody>
      <% transactions.forEach((item) => { %>
      <tr class="emails-row" x-on:click="location.href = '/app/transactions/<%= item.id %>'">
        <td data-label="Date"><time datetime="<%= item.transactionDate.toISOString() %>"><%= fmt.formatDateTime(item.transactionDate) %></time></td>
        <td data-label="Merchant"><a href="/app/transactions/<%= item.id %>" x-on:click.stop><%= fmt.titleCase(item.merchant) %></a></td>
        <td data-label="Category">
          <% if (item.category) { %>
          <span class="categories-chip" style="--category-color: <%= item.category.color ?? '#64748b' %>">
            <span class="categories-icon" aria-hidden="true"><%= item.category.icon || '•' %></span>
            <%= item.category.name %>
          </span>
          <% } else { %><span class="categories-badge">Uncategorized</span><% } %>
        </td>
        <td data-label="Amount" class="amount<%= item.operationType === 'CREDIT' ? ' amount-credit' : '' %>"><%= item.operationType === 'CREDIT' ? '+' : '' %><%= fmt.formatMoney(item.amount, item.currency) %></td>
        <td class="emails-row-actions"><% if (item.email) { %><a href="/app/emails/<%= item.email.id %>" x-on:click.stop>Email</a><% } %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  </div>

  <%
    const monthQuery = month ? `&month=${month}` : '';
  %>
  <nav class="emails-pager" aria-label="Pagination">
    <% if (newerCursor) { %>
    <a href="/app/transactions?after=<%= newerCursor %><%= monthQuery %>" role="button" class="outline secondary">&larr; Newer</a>
    <% } else { %><span></span><% } %>
    <% if (olderCursor) { %>
    <a href="/app/transactions?before=<%= olderCursor %><%= monthQuery %>" role="button" class="outline secondary">Older &rarr;</a>
    <% } %>
  </nav>
  <% } %>

  <%- include('../partials/transaction-dialogs') %>
</div>
