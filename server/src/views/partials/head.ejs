    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> · kwq</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@picocss/pico@2.1.1/css/pico.slate.min.css"
    />
    <style>
      :root[data-theme="dark"] {
        --pico-primary: #e08a83;
        --pico-primary-background: #b3413c;
        --pico-primary-border: var(--pico-primary-background);
        --pico-primary-hover: #eda9a3;
        --pico-primary-hover-background: #c2534e;
        --pico-primary-hover-border: var(--pico-primary-hover-background);
        --pico-primary-focus: rgba(224, 138, 131, 0.5);
        --pico-primary-underline: rgba(224, 138, 131, 0.5);
        --pico-primary-hover-underline: var(--pico-primary-hover);
        --pico-primary-inverse: #fff;
      }

      .app-shell {
        display: flex;
        align-items: flex-start;
        gap: 2rem;
      }

      .app-sidebar {
        flex: 0 0 14rem;
        display: flex;
        flex-direction: column;
        /* Pico's base `nav` rule sets justify-content: space-between for
           horizontal navbars; override it or a column nav spreads its
           links across the full height instead of stacking them. */
        justify-content: flex-start;
        gap: 0.25rem;
      }

      .app-sidebar a {
        display: block;
        padding: 0.5rem 0.75rem;
        border-left: 2px solid transparent;
        color: var(--pico-color);
        text-decoration: none;
      }

      .app-sidebar a:hover {
        color: var(--pico-primary);
      }

      .app-sidebar a[aria-current='page'] {
        border-left-color: var(--pico-primary);
        color: var(--pico-primary);
        font-weight: 600;
      }

      .app-sidebar .soon {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 0.5rem;
        padding: 0.5rem 0.75rem;
        color: var(--pico-muted-color);
      }

      .app-sidebar .soon small {
        color: var(--pico-muted-color);
      }

      .app-content {
        flex: 1 1 auto;
        min-width: 0;
      }

      .app-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .profile-menu {
        position: relative;
      }

      .profile-face {
        width: 2.25rem;
        height: 2.25rem;
        padding: 0;
        border: none;
        border-radius: 50%;
        background: var(--pico-primary-background);
        color: var(--pico-primary-inverse);
        font-weight: 600;
      }

      .profile-dropdown {
        position: absolute;
        top: calc(100% + 0.5rem);
        right: 0;
        z-index: 30;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 0.75rem;
        min-width: 12rem;
        background: var(--pico-background-color);
        border: 1px solid var(--pico-muted-border-color);
        border-radius: var(--pico-border-radius);
      }

      .profile-dropdown form {
        margin: 0;
      }

      .profile-dropdown .profile-email {
        font-size: 0.875rem;
        color: var(--pico-muted-color);
        word-break: break-all;
      }

      .profile-dropdown a {
        color: var(--pico-color);
        text-decoration: none;
        padding: 0.25rem 0;
      }

      .profile-dropdown a:hover {
        color: var(--pico-primary);
      }

      .webhook-token-reveal code {
        flex: 1 1 auto;
        overflow-wrap: anywhere;
      }

      .webhook-token-error {
        color: var(--pico-del-color);
      }

      @media (max-width: 480px) {
        .webhook-token-reveal [role='group'] {
          flex-direction: column;
          align-items: stretch;
        }

        .webhook-token-reveal code {
          border-radius: var(--pico-border-radius) var(--pico-border-radius)
            0 0;
        }

        .webhook-token-reveal [role='group'] button {
          width: 100%;
          margin: 0;
          border-radius: 0 0 var(--pico-border-radius)
            var(--pico-border-radius);
        }

        dialog article {
          padding: 1rem;
        }

        dialog footer {
          flex-direction: column-reverse;
          align-items: stretch;
        }

        dialog footer button {
          width: 100%;
          margin: 0;
        }
      }

      [x-cloak] {
        display: none !important;
      }

      .users-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      .users-header button {
        width: auto;
      }

      .users-empty {
        color: var(--pico-muted-color);
      }

      .users-row-actions {
        display: flex;
        gap: 0.5rem;
        justify-content: flex-end;
      }

      .users-row-actions button {
        width: auto;
        padding: 0.25rem 0.75rem;
        margin: 0;
      }

      .users-form-error {
        margin: 0 0 1rem;
        padding: 0.65rem 0.85rem;
        border-left: 3px solid var(--pico-del-color);
        border-radius: var(--pico-border-radius);
        background: color-mix(in srgb, var(--pico-del-color) 14%, transparent);
        color: var(--pico-del-color);
        font-size: 0.875rem;
        line-height: 1.4;
      }

      .categories-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1rem;
      }

      .categories-header h1 {
        margin: 0;
        font-size: 1.75rem;
      }

      .amount {
        text-align: right;
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
      }

      .amount-credit {
        color: var(--pico-ins-color);
      }

      .categories-badge.badge-ok {
        color: var(--pico-ins-color);
      }

      .categories-badge.badge-fail {
        color: var(--pico-del-color);
      }

      .list-table th,
      .list-table td {
        padding-inline: 0.6rem;
      }

      .emails-row-actions a {
        white-space: nowrap;
      }

      .not-found {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: calc(100dvh - 10rem);
        text-align: center;
      }

      .not-found-code {
        margin: 0;
        color: var(--pico-primary);
        font-size: clamp(5rem, 28vw, 11rem);
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.04em;
        font-variant-numeric: tabular-nums;
      }

      .not-found h1 {
        margin: 0.5rem 0;
        font-size: clamp(1.4rem, 5vw, 2rem);
      }

      .not-found-detail {
        max-width: 32rem;
        color: var(--pico-muted-color);
      }

      .not-found-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem;
      }

      .not-found-actions a {
        margin: 0;
      }

      .toast {
        position: fixed;
        right: 1.25rem;
        bottom: 1.25rem;
        z-index: 100;
        padding: 0.65rem 1rem;
        border-left: 3px solid var(--pico-ins-color);
        border-radius: var(--pico-border-radius);
        background: var(--pico-card-background-color);
        box-shadow: var(--pico-card-box-shadow);
      }

      .categories-header button {
        width: auto;
      }

      .categories-empty {
        color: var(--pico-muted-color);
      }

      .categories-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.2rem 0.7rem 0.2rem 0.3rem;
        border-left: 3px solid var(--category-color);
        background: color-mix(in srgb, var(--category-color) 16%, transparent);
        border-radius: var(--pico-border-radius);
      }

      .categories-icon {
        display: inline-grid;
        place-items: center;
        min-width: 1.6rem;
        height: 1.6rem;
        border-radius: 50%;
        background: var(--category-color);
        font-size: 0.9rem;
      }

      .categories-hex {
        font-size: 0.8rem;
        background: none;
        padding: 0;
        color: var(--pico-muted-color);
      }

      .categories-badge {
        display: inline-block;
        padding: 0.1rem 0.6rem;
        border: 1px solid var(--pico-muted-border-color);
        border-radius: 999px;
        font-size: 0.75rem;
        color: var(--pico-muted-color);
      }

      .categories-actions {
        display: flex;
        gap: 0.5rem;
        justify-content: flex-end;
        align-items: center;
      }

      .categories-actions {
        flex-wrap: wrap;
      }

      .categories-actions button,
      .categories-actions a[role="button"] {
        width: auto;
        padding: 0.25rem 0.75rem;
        margin: 0;
        font-size: 1rem;
        line-height: 1.5;
        min-width: 6rem;
        text-align: center;
      }

      .categories-form-error {
        margin: 0 0 1rem;
        padding: 0.65rem 0.85rem;
        border-left: 3px solid var(--pico-del-color);
        border-radius: var(--pico-border-radius);
        background: color-mix(in srgb, var(--pico-del-color) 14%, transparent);
        color: var(--pico-del-color);
        font-size: 0.875rem;
        line-height: 1.4;
      }

      .emails-filter {
        display: flex;
        align-items: end;
        gap: 0.5rem;
        margin-bottom: 1rem;
      }

      .emails-filter label {
        margin: 0;
      }

      .emails-filter input,
      .emails-filter button,
      .emails-filter a {
        margin: 0;
        width: auto;
      }

      .emails-row {
        cursor: pointer;
      }

      .emails-row code,
      .categories-header h1 {
        overflow-wrap: anywhere;
      }

      .emails-pager a {
        margin: 0;
      }

      .emails-row:hover {
        background: var(--pico-table-row-stripped-background-color);
      }

      .emails-pager {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
      }

      .emails-meta {
        display: grid;
        grid-template-columns: max-content 1fr;
        gap: 0.25rem 1rem;
      }

      .emails-meta dt {
        color: var(--pico-muted-color);
      }

      .emails-meta dd {
        margin: 0;
        overflow-wrap: anywhere;
      }

      .emails-preview {
        width: 100%;
        height: 70vh;
        border: 1px solid var(--pico-muted-border-color);
        border-radius: var(--pico-border-radius);
        background: #fff;
      }

      @media (max-width: 640px) {
        .users-header,
        .categories-header {
          flex-direction: column;
          align-items: stretch;
        }

        .users-header button,
        .categories-header button {
          width: 100%;
        }

        table thead {
          display: none;
        }

        table,
        table tbody,
        table tr,
        table td {
          display: block;
          width: 100%;
        }

        table tr {
          margin-bottom: 1rem;
          padding: 0.75rem;
          border: 1px solid var(--pico-muted-border-color);
          border-radius: var(--pico-border-radius);
        }

        table td {
          border: none;
          padding: 0.35rem 0;
        }

        .amount {
          text-align: left;
        }

        .emails-row-actions:empty {
          display: none;
        }

        .toast {
          right: 1rem;
          left: 1rem;
        }

        .not-found-actions,
        .not-found-actions a {
          width: 100%;
        }

        .emails-filter {
          flex-wrap: wrap;
        }

        .emails-filter label {
          flex: 1 1 100%;
        }

        .emails-filter button,
        .emails-filter a {
          flex: 1 1 0;
          text-align: center;
          width: auto;
        }

        .emails-pager a {
          flex: 1 1 0;
          text-align: center;
        }

        .emails-preview {
          height: 60vh;
        }

        table td:not(.users-row-actions):not(.categories-row-actions):not(.emails-row-actions)::before {
          content: attr(data-label);
          display: block;
          font-size: 0.75rem;
          color: var(--pico-muted-color);
        }

        .users-row-actions {
          justify-content: flex-start;
          padding-top: 0.5rem;
        }

        .categories-actions {
          justify-content: flex-start;
          padding-top: 0.5rem;
        }

        /* Equal-width action buttons across the card. */
        .categories-actions button,
        .categories-actions a[role="button"] {
          flex: 1 1 0;
          text-align: center;
        }
      }

      .sidebar-toggle {
        display: none;
      }

      .sidebar-backdrop {
        display: none;
      }

      @media (max-width: 768px) {
        /* Pico scales --pico-font-size up from 576px, for desktop reading
           comfort. The overlay drawer below is sized in rem and wants to
           stay compact, so pin the scale back down while it's in play. */
        :root {
          --pico-font-size: 100%;
        }

        .sidebar-toggle {
          display: inline-flex;
        }

        .app-shell {
          gap: 0;
        }

        .app-sidebar {
          position: fixed;
          inset: 0 auto 0 0;
          z-index: 20;
          width: 14rem;
          padding: 1.5rem 1rem;
          background: var(--pico-background-color);
          border-right: 1px solid var(--pico-muted-border-color);
          transform: translateX(-100%);
          transition: transform 0.2s ease;
        }

        .app-shell.sidebar-open .app-sidebar {
          transform: translateX(0);
        }

        .app-shell.sidebar-open .sidebar-backdrop {
          display: block;
          position: fixed;
          inset: 0;
          z-index: 10;
          background: rgba(0, 0, 0, 0.5);
        }
      }
    </style>
    <script
      defer
      src="https://cdn.jsdelivr.net/npm/alpinejs@3.17.3/dist/cdn.min.js"
    ></script>
