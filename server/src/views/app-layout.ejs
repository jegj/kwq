<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <%- include('./partials/head') %>
  </head>
  <body x-data="{ sidebarOpen: false }">
    <header class="container app-header">
      <span
        style="
          display: inline-flex;
          align-items: center;
          gap: 0.5rem;
          color: var(--pico-primary);
        "
      >
        <button
          type="button"
          class="sidebar-toggle outline"
          aria-label="Toggle navigation"
          x-on:click="sidebarOpen = !sidebarOpen"
          style="padding: 0.25rem 0.6rem;"
        >
          ☰
        </button>
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="2" y="2" width="20" height="20" rx="6" fill="currentColor" stroke="none" />
          <path
            d="M5.5 12C7.5 8.8 9.7 8 12 8s4.5.8 6.5 4c-2 3.2-4.2 4-6.5 4s-4.5-.8-6.5-4Z"
            stroke="var(--pico-background-color)"
            stroke-width="1.6"
          />
          <circle cx="12" cy="12" r="1.8" fill="var(--pico-background-color)" stroke="none" />
        </svg>
        <strong>kwq</strong>
      </span>

      <div class="profile-menu" x-data="{ open: false }" x-on:click.outside="open = false">
        <button
          type="button"
          class="profile-face"
          aria-label="Account menu"
          x-on:click="open = !open"
        ><%= email.charAt(0).toUpperCase() %></button>
        <div class="profile-dropdown" x-show="open" x-cloak>
          <span class="profile-email"><%= email %></span>
          <a href="/app/settings">Settings</a>
          <form method="post" action="/auth/logout">
            <button type="submit" class="outline secondary">Log out</button>
          </form>
        </div>
      </div>
    </header>
    <main class="container">
      <div class="app-shell" x-bind:class="sidebarOpen ? 'sidebar-open' : ''">
        <div
          class="sidebar-backdrop"
          x-on:click="sidebarOpen = false"
          aria-hidden="true"
        ></div>
        <nav class="app-sidebar" aria-label="App navigation">
          <a href="/app/dashboard" <% if (currentPath === '/app/dashboard') { %>aria-current="page"<% } %>>Dashboard</a>
          <% if (role === 'ADMIN') { %>
          <a href="/app/admin/users" <% if (currentPath === '/app/admin/users') { %>aria-current="page"<% } %>>Users</a>
          <% } %>
          <a href="/app/transactions" <% if (currentPath === '/app/transactions') { %>aria-current="page"<% } %>>Transactions</a>
          <a href="/app/categories" <% if (currentPath === '/app/categories') { %>aria-current="page"<% } %>>Categories</a>
          <a href="/app/emails" <% if (currentPath === '/app/emails') { %>aria-current="page"<% } %>>Email Notifications</a>
        </nav>
        <div class="app-content">
          <%- include(page) %>
        </div>
      </div>
    </main>
    <div
      class="toast"
      role="status"
      x-data="toast"
      x-show="message"
      x-text="message"
      x-cloak
    ></div>
  </body>
</html>
